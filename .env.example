# Copy to .env and fill in. .env is gitignored; never commit real keys.
#
# Only secrets and machine-local settings belong here. Model tags, prices and
# policy parameters are pinned in configs/ and must not be overridden from env.

# --- Frontier tier (Anthropic SDK) -------------------------------------------
# Required for the frontier sweep only. Not needed for `make smoke` in replay mode.
# Set an API key specific to this project scope with a spending cap
ESCALATOR_ANTHROPIC_KEY=

# --- Small tier (OpenAI-compatible HTTP, e.g. Ollama / vLLM / llama.cpp) -----
SMALL_TIER_BASE_URL=http://localhost:11434/v1
# Most local servers ignore the key but the OpenAI-compatible API expects one.
SMALL_TIER_API_KEY=local

# --- LLM cache ----------------------------------------------------------------
# record: call the model on cache miss and store the response
# replay: cache only; a miss is an error (used by CI, guarantees $0)
ESCALATOR_CACHE_MODE=record
ESCALATOR_CACHE_PATH=.cache/llm.sqlite

# --- Paths --------------------------------------------------------------------
# Directory holding the BIRD Mini-Dev SQLite databases (task ids come from data/manifest.json).
BIRD_DATA_DIR=data/raw
ESCALATOR_TRACES_DIR=traces

# --- Spend guard --------------------------------------------------------------
# Hard stop for paid tokens across a run, in USD, as metered via configs/prices.yaml.
# Project budget is $60 total; keep per-run caps well below that.
ESCALATOR_MAX_USD_PER_RUN=15
