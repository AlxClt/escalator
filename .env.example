
ESCALATOR_ANTHROPIC_KEY=

# Local/small models are served with ollama
OLLAMA_BASE_URL=http://localhost:11434
# Optional, left empty. No parallelism has been implemented yet
OLLAMA_NUM_PARALLEL=

# LLM cache 
# readwrite: uses the cache, calls the model if missing (default)
# readonly: cache only, raises CacheError if missing
ESCALATOR_CACHE_MODE=readwrite
ESCALATOR_CACHE_PATH=.cache/llm.sqlite

# Bird data dir
BIRD_DATA_DIR=data/raw
ESCALATOR_TRACES_DIR=traces

# Max USD per run for paid model
ESCALATOR_MAX_USD_PER_RUN=15
